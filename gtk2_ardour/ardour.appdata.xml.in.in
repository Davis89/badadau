<?xml version="1.0" encoding="UTF-8"?>
<!-- Badadau fork modification, 2026-08-24: derivative product metadata. -->
<component type="desktop">
  <id>@ARDOUR_EXEC@.desktop</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0+</project_license>
  <name>@PROGRAM_NAME@</name>
  <releases>
    <release version="@VERSION@" date="@DATE@" />
  </releases>
  <summary>Digital Audio Workstation</summary>
  <description>
    <p>
      @PROGRAM_NAME@ is a multi-channel digital audio workstation for
      recording, composing, editing, mixing and mastering audio and MIDI.
    </p>
    <p>
      This fork is built on the Ardour audio engine while developing a
      streamlined production-oriented user experience.
    </p>
  </description>
  <keywords>
    <keyword>@PROGRAM_NAME@</keyword>
    <keyword>DAW</keyword>
    <keyword>Digital Audio Workstation</keyword>
    <keyword>Mixing</keyword>
    <keyword>Mastering</keyword>
  </keywords>
</component>
